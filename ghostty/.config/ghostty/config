# vi: set ft=dosini :
font-family = "Berkeley Mono"
font-feature = -calt
font-feature = -liga
font-feature = -dlig
font-size = 16

background-opacity = 1
background-blur-radius = 20

shell-integration = fish

working-directory = home
window-inherit-working-directory = false

macos-titlebar-style = tabs
macos-option-as-alt = right

window-width = 111
window-height = 27
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true
window-save-state = never

unfocused-split-opacity = 0.6

mouse-hide-while-typing = true

# necessary due to multi-line prompt
keybind = super+down=jump_to_prompt:3
keybind = super+up=jump_to_prompt:-3

keybind = cmd+\=toggle_tab_overview

keybind = shift+enter=text:\n

keybind = alt+backspace=text:\x1b\x7f

bell-features = no-system,no-audio,no-attention,no-title,no-border

custom-shader = ~/.config/ghostty/shaders/cursor_warp.glsl

config-file = ?auto/theme.ghostty
